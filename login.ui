  <property name="styleSheet"><string notr="true">
QMainWindow { background-color: #0A0A0B; }
QWidget#centralwidget { background-color: #0A0A0B; }
QWidget#card { background-color: #151517; border: 1px solid #262629; border-radius: 24px; }
QLabel#lblLogo { font-size: 48px; color: #FFFFFF; background: transparent; qproperty-alignment: AlignCenter; }
QLabel#lblTitle { font-size: 32px; font-weight: 800; color: #FFFFFF; background: transparent; qproperty-alignment: AlignCenter; }
