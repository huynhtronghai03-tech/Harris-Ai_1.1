QLineEdit { background-color: #1E1E20; color: #FFFFFF; border: 1px solid #2C2C2E; border-radius: 12px; padding: 16px 18px; font-size: 14px; }
QLineEdit:focus { border: 1px solid #00D4FF; background-color: #232325; }
QCheckBox { color: #8A8A8E; font-size: 13px; spacing: 8px; background: transparent; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1.5px solid #3A3A3E; border-radius: 5px; background: #1E1E20; }
QCheckBox::indicator:checked { background: #00D4FF; border-color: #00D4FF; }
QPushButton#btnLogin { background-color: #FFFFFF; color: #000000; border-radius: 12px; padding: 16px; font-size: 15px; font-weight: 700; }
QPushButton#btnLogin:hover { background-color: #E8E8E8; }
QPushButton#btnGoRegister { background-color: #1E1E20; color: #FFFFFF; border: 1px solid #2C2C2E; border-radius: 12px; padding: 14px; font-size: 13px; font-weight: 600; }
QPushButton#btnGoRegister:hover { background-color: #262629; border-color: #3A3A3E; }
QLabel#lblQuestion { color: #6A6A6E; font-size: 12px; background: transparent; qproperty-alignment: AlignCenter; }
</string></property>
